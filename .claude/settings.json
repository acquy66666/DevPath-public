{
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm install)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(pnpm run:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(alembic:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "grep -q 'git commit' && git push -u origin HEAD 2>&1 | tail -3 || true",
            "timeout": 60,
            "statusMessage": "Pushing to origin..."
          }
        ]
      }
    ]
  }
}
