# Copy to backend/.env when running the backend from a venv on the host
# (backend/README.md). Never commit .env. Inside Docker this file is not read:
# infra/.env and the compose file set the environment. Every setting not listed
# here has a working default in app/core/config.py (rate limits, token TTLs,
# model tuning).
ENV=development
DEBUG=true

# Postgres and Redis of the dev stack, published on localhost by
# infra/docker-compose.yml (POSTGRES_PORT / REDIS_PORT in infra/.env)
DATABASE_URL=postgresql+asyncpg://devpath:devpath@localhost:5432/devpath

# Redis — cache, session, Celery broker, grading pub/sub
REDIS_URL=redis://localhost:6379/0

# Auth — generate a real key for production:  openssl rand -hex 32
# The app refuses to start with this default when ENV=production.
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Seconds a just-rotated refresh token may come back -- a second tab sharing
# the cookie -- before it counts as stolen
REFRESH_TOKEN_REUSE_LEEWAY_SECONDS=30

# Google OAuth — leave empty to disable the "sign in with Google" endpoints.
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add GOOGLE_REDIRECT_URI
# below to its list of authorised redirect URIs, exactly as written.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Where the browser is sent after the OAuth round trip finishes.
FRONTEND_URL=http://localhost:3000

# Object storage — Cloudflare R2, S3-compatible. Empty means the video upload
# endpoints answer 503 STORAGE_NOT_CONFIGURED and the rest of the app is fine.
# Step-by-step setup: docs/huong-dan-cloudflare-r2.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=devpath-media
# Where finished HLS files are read from (the bucket's r2.dev subdomain, or a
# custom domain once there is one).
R2_PUBLIC_BASE_URL=
# Override the S3 endpoint for a server that is not R2 (the stack's RustFS). Leave
# empty for R2: the endpoint is derived from R2_ACCOUNT_ID.
R2_ENDPOINT_URL=
# How long a signed upload URL stays valid.
UPLOAD_URL_TTL_SECONDS=3600

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Gemini (https://aistudio.google.com/apikey). Empty: the RAG ingest job skips,
# and the chat and quiz-generation endpoints answer "chưa cấu hình".
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_THINKING_LEVEL=minimal

# VNPay sandbox. Empty: POST /orders/{code}/payment-url answers 503 and the IPN
# refuses every callback. Any two values switch the flow on locally, where
# `python -m scripts.simulate_vnpay_ipn <order code>` stands in for VNPay.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/thanh-toan/ket-qua

# How often one student may ask for grading (per exercise / per hour).
SUBMISSION_COOLDOWN_SECONDS=10
SUBMISSION_HOURLY_LIMIT=40
