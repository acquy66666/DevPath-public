# Copy to .env.local for local development. Never commit .env.local.

# Base URL the browser uses to reach the FastAPI backend. Must be reachable
# from the user's machine, so it stays a host address even under Docker.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional. Overrides the above for Server Components only. Docker Compose sets
# this to http://backend:8000 so server-side fetches skip the host round trip;
# outside Docker leave it unset.
# API_BASE_URL_INTERNAL=http://backend:8000
