# Copy to .env and adjust. Never commit .env.
ENV=development
DEBUG=true

# Postgres — hostname is the compose service name when running in Docker
DATABASE_URL=postgresql+asyncpg://devpath:devpath@localhost:5432/devpath

# Redis — cache, session, Celery broker, grading pub/sub
REDIS_URL=redis://localhost:6379/0

# Auth — generate a real key for production:  openssl rand -hex 32
# The app refuses to start with this default when ENV=production.
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth — leave empty to disable the "sign in with Google" endpoints.
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add GOOGLE_REDIRECT_URI
# below to its list of authorised redirect URIs, exactly as written.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Where the browser is sent after the OAuth round trip finishes.
FRONTEND_URL=http://localhost:3000

# Object storage — Cloudflare R2, S3-compatible. Empty means the video upload
# endpoints answer 503 STORAGE_NOT_CONFIGURED and the rest of the app is fine.
# Step-by-step setup: docs/huong-dan-cloudflare-r2.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=devpath-media
# Where finished HLS files are read from (the bucket's r2.dev subdomain, or a
# custom domain once there is one).
R2_PUBLIC_BASE_URL=
# Override the S3 endpoint for a server that is not R2 (a local MinIO). Leave
# empty for R2: the endpoint is derived from R2_ACCOUNT_ID.
R2_ENDPOINT_URL=
# How long a signed upload URL stays valid.
UPLOAD_URL_TTL_SECONDS=3600

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
