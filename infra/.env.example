# Copy to infra/.env and adjust. Compose reads this file automatically.
# Never commit infra/.env.

# --- Postgres ---
POSTGRES_USER=devpath
POSTGRES_PASSWORD=devpath
POSTGRES_DB=devpath
# Host port. Change if 5432 is already taken by a local Postgres install.
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Application ports on the host ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Auth ---
# Commented out = the default shown, which is what docker-compose.yml falls
# back to. This one is fine for a laptop and nowhere else: the app refuses to
# start with it when ENV=production.
# JWT_SECRET=dev-only-insecure-secret-change-me

# --- Google sign-in ---
# Off until an OAuth client exists in Google Cloud Console: the endpoints answer
# 503 and password login carries on. Register the redirect URI exactly as below.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Whether the frontend draws the button. Turn it on together with the two keys
# above, or the button leads to a 503; restart the frontend container after.
# GOOGLE_LOGIN_ENABLED=false

# --- Object storage ---
# Left empty, every R2_* below points at the `storage` service (RustFS) of this
# stack, so
# video, avatar and transcript uploads work with no account anywhere. Use
# Chrome or Edge on http://localhost:3000: uploads and playback go to
# http://minio.localhost:9000, a name browsers send to 127.0.0.1 by themselves
# but the Windows resolver does not know -- so a script that touches storage
# runs inside a container (`docker compose exec worker python -m ...`).
#
# To use a real Cloudflare R2 bucket from the dev stack instead, fill in ALL of
# them, R2_ENDPOINT_URL included (https://<account id>.r2.cloudflarestorage.com):
# an empty one falls back to the local storage, not to R2.
# docs/huong-dan-cloudflare-r2.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=devpath-media
R2_PUBLIC_BASE_URL=
R2_ENDPOINT_URL=

# The local storage's key pair -- also the one the app signs with while R2_*
# above are empty. No web console; look inside the bucket with the S3 API, as
# infra/README.md shows.
STORAGE_ACCESS_KEY=devpath
STORAGE_SECRET_KEY=devpath-storage

# --- Database backups ---
# Only for `docker compose --profile backup ...` (infra/README.md). With R2_*
# empty, backups go to this bucket of the storage above, created private -- never
# the media bucket, which anyone can read.
BACKUP_BUCKET=devpath-backups
BACKUP_KEEP=14
BACKUP_HOUR=2

# --- Grading ---
# How many submissions are graded at once. Each one holds a sandbox container
# with half a core and 256 MB; two is right for a laptop and for a 2 vCPU VPS.
GRADING_CONCURRENCY=2

# How often one student may ask for grading. The cooldown is per exercise and
# stops a double-clicked button; the hourly quota is per student across every
# exercise and stops a script that waits the cooldown out. Both are far above
# what iterating on an exercise looks like.
SUBMISSION_COOLDOWN_SECONDS=10
SUBMISSION_HOURLY_LIMIT=40

# Gemini (Google AI Studio). Trống thì job ingest bỏ qua và các endpoint chat
# trả lời "chưa cấu hình" -- phần còn lại của nền tảng chạy bình thường.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Model viết câu trả lời của trợ giảng. Chọn theo số đo, xem
# docs/report/assets/phase-4/chat-api.txt. Model họ 2.5 thì để trống
# THINKING_LEVEL (chúng nhận thinkingBudget, từ chối thinkingLevel).
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_THINKING_LEVEL=minimal

# VNPay sandbox. Trống thì `POST /orders/{code}/payment-url` trả 503 "chưa cấu
# hình" và IPN từ chối mọi callback (không có secret thì không kiểm được chữ ký
# nào cả) -- phần còn lại của nền tảng chạy bình thường.
#
# Đăng ký merchant sandbox ở https://sandbox.vnpayment.vn/devreg/ rồi dán hai
# giá trị đầu vào infra/.env. Trong phần cấu hình của merchant, khai IPN URL là
# <địa chỉ công khai>/api/v1/payments/vnpay/ipn -- VNPay gọi thẳng vào backend
# nên localhost không dùng được, hãy lấy URL từ Cloudflare Quick Tunnel.
#
# Muốn xem luồng chạy mà chưa có tài khoản: đặt hai giá trị bất kỳ rồi dùng
# `python -m scripts.simulate_vnpay_ipn` -- script ký bằng đúng secret backend
# dùng để kiểm, nên chỉ có trang của ngân hàng là thiếu.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/thanh-toan/ket-qua
