# Copy to infra/.env and adjust. Compose reads this file automatically.
# Never commit infra/.env.

# --- Postgres ---
POSTGRES_USER=devpath
POSTGRES_PASSWORD=devpath
POSTGRES_DB=devpath
# Host port. Change if 5432 is already taken by a local Postgres install.
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Application ports on the host ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Object storage (Cloudflare R2) ---
# Empty means the video upload endpoints answer 503 and everything else runs
# as normal. Filling these in: docs/huong-dan-cloudflare-r2.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=devpath-media
R2_PUBLIC_BASE_URL=
# Only for an S3-compatible server that is not R2 (a local MinIO, for example).
R2_ENDPOINT_URL=

# --- Grading ---
# How many submissions are graded at once. Each one holds a sandbox container
# with half a core and 256 MB; two is right for a laptop and for a 2 vCPU VPS.
GRADING_CONCURRENCY=2

# How often one student may ask for grading. The cooldown is per exercise and
# stops a double-clicked button; the hourly quota is per student across every
# exercise and stops a script that waits the cooldown out. Both are far above
# what iterating on an exercise looks like.
SUBMISSION_COOLDOWN_SECONDS=10
SUBMISSION_HOURLY_LIMIT=40

# Gemini (Google AI Studio). Trống thì job ingest bỏ qua và các endpoint chat
# trả lời "chưa cấu hình" -- phần còn lại của nền tảng chạy bình thường.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
