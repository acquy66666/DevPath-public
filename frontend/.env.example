# Copy to .env.local for local development. Never commit .env.local.

# Base URL the browser uses to reach the FastAPI backend. Must be reachable
# from the user's machine, so it stays a host address even under Docker.
# Keep it on `localhost`, not `127.0.0.1`: the two count as different sites,
# and the SameSite=lax refresh cookie would never be sent from a page served
# at localhost:3000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional. Overrides the above for Server Components only. Docker Compose sets
# this to http://backend:8000 so server-side fetches skip the host round trip;
# outside Docker leave it unset.
# API_BASE_URL_INTERNAL=http://backend:8000

# Show the "sign in with Google" button. Only turn this on once the backend has
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET, or the button leads to a 503.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false

# Public address of this site, used to build absolute URLs in <head> -- the
# canonical link and the Open Graph tags a crawler or a chat app reads. Set it
# to the real domain on the VPS; localhost is right for development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
