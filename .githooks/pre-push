#!/bin/sh
#
# Blocks force-push and deletion of protected branches.
#
# The server-side rule is the guarantee: a repository ruleset on `main` with
# `deletion` and `non_fast_forward`, no bypass actors, added once the Student
# Developer Pack turned the account Pro and rulesets became available on a
# private repo.
#
# This hook stays anyway, for the one thing the server cannot do: fail in a
# tenth of a second instead of after a push has uploaded everything. It is
# bypassable with --no-verify and protects only this working copy, so it is a
# faster no, never the only one.
#
# Enabled via: git config core.hooksPath .githooks

protected="main"
zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')

while read -r local_ref local_sha remote_ref remote_sha; do
	branch=${remote_ref#refs/heads/}
	case " $protected " in
		*" $branch "*) ;;
		*) continue ;;
	esac

	if [ "$local_sha" = "$zero" ]; then
		echo "pre-push: refusing to delete '$branch' on the remote." >&2
		exit 1
	fi

	if [ "$remote_sha" = "$zero" ]; then
		continue
	fi

	if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
		echo "pre-push: remote commit $remote_sha is unknown locally; run 'git fetch' and try again." >&2
		exit 1
	fi

	if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
		echo "pre-push: refusing non-fast-forward push to '$branch' -- this would rewrite history." >&2
		echo "pre-push: if you really mean it, re-run with --no-verify." >&2
		exit 1
	fi
done

exit 0
