# The deploy scripts run on the VPS. A CRLF checkout on a Windows machine
# would travel into the repo and break the shebang on Linux, so these are
# pinned to LF regardless of core.autocrlf.
*.sh text eol=lf

# Same reasoning: read inside a Linux container, never by a Windows tool.
*.template text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
# Written by uv inside a container (backend/scripts/lock.sh), which reads the
# old file back for its pins: keep it byte-for-byte what uv writes.
requirements.lock text eol=lf

# Seed transcripts are uploaded byte for byte, and 1-0.srt keeps the BOM and
# CRLF of a file saved by a Windows subtitle editor on purpose: it is the file
# the transcript parser was first tried on (docs/report/assets/phase-4/).
backend/scripts/seed_data/transcripts/** -text

# Grading fixtures stand in for submitted code. A CRLF checkout would make
# them differ on Windows from what the same file grades as on the server,
# and line endings are exactly what this part of the system is sensitive to.
grader/tests/fixtures/* text eol=lf
