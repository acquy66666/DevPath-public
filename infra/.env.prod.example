# Copy to infra/.env.prod on the VPS and fill in. Never commit infra/.env.prod.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# Compose does not read this file by name, so every command passes it:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod <...>
# The scripts in scripts/ already do.

# --- The site -----------------------------------------------------------
# Bare hostname, no scheme and no trailing slash. Its A record must already
# point at this machine before you ask for a certificate.
DOMAIN=devpath.example.com
# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
ACME_EMAIL=you@example.com

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=devpath
# Generate one, do not think one up:  openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=devpath

# --- Auth ---------------------------------------------------------------
# The app refuses to start in production with the development default.
#   openssl rand -hex 32
JWT_SECRET=

# --- Google sign-in -----------------------------------------------------
# Leave empty to keep it switched off; the endpoints answer 503 and password
# login carries on. The redirect URI is built from DOMAIN, so register exactly
#   https://<DOMAIN>/api/v1/auth/google/callback
# in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Whether the frontend draws the button. Baked into the bundle at build time,
# so changing it means rebuilding the frontend image.
GOOGLE_LOGIN_ENABLED=false

# --- Object storage ----------------------------------------------------
# Videos, avatars, banners, transcripts and certificate PDFs live in the
# `storage` service (RustFS) on this machine, served at
# https://<DOMAIN>/devpath-media/ through nginx. Its key pair -- the app signs
# with it too. Generate both, do not think them up:
#   openssl rand -hex 16      (access key)
#   openssl rand -hex 32      (secret key)
# Compose refuses to start without them. Keep them: the server checks every
# request against them, and changing them later is a restart, not a migration.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Cloudflare R2 instead of the local storage (it wants a payment card, which
# is why it is not the default): fill in ALL of these, endpoint and public URL
# included, as docs/huong-dan-cloudflare-r2.md shows. Left empty, the app
# uses the storage above.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=devpath-media
R2_PUBLIC_BASE_URL=
R2_ENDPOINT_URL=

# --- Database backups ---------------------------------------------------
# The `backup` service dumps the database every night to BACKUP_BUCKET and
# keeps the newest BACKUP_KEEP. OFF this machine: the storage above shares the
# server's disk, and a backup that dies with the server is not one. So not
# STORAGE_*, and not the media bucket (public; the service refuses it).
#
# Backblaze B2 (10 GB free, no payment card -- docs/huong-dan-deploy-vps.md,
# mục 2c): a PRIVATE bucket, and an application key restricted to it with
# read and write. BACKUP_ENDPOINT_URL is the bucket's "Endpoint" with https://
# in front, e.g. https://s3.us-west-004.backblazeb2.com -- the signing region
# is taken from it (B2 refuses any other).
#
# Or a private R2 bucket, if R2_* above are filled in: then BACKUP_* may stay
# empty and the R2 key is used, though a token scoped to this one bucket is
# better -- a leaked app key then cannot delete the backups too.
#
# Without either, the service stays up but unhealthy and deploy.sh stops on it.
# Running with no backups is allowed only by saying so: BACKUP_ENABLED=false.
BACKUP_ENABLED=true
BACKUP_BUCKET=devpath-backups
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_ENDPOINT_URL=
# Hour of the day, Vietnam time. 02:00 sits clear of the 02:30-03:30 jobs.
BACKUP_HOUR=2
BACKUP_KEEP=14

# --- VNPay ------------------------------------------------------------------
# Empty means POST /orders/{code}/payment-url answers 503 "chưa cấu hình" and
# the IPN refuses every callback; the rest of the site runs normally. Values
# from the merchant registration at https://sandbox.vnpayment.vn/devreg/.
# The return URL is built from DOMAIN by the compose file. VNPay must be told
# the IPN URL -- https://<DOMAIN>/api/v1/payments/vnpay/ipn -- by e-mail to its
# technical team: the sandbox merchant portal has no field for it.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# The sandbox gateway. Switch to the production one only with a production
# merchant account.
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# --- Monitoring (host timer, not a container) ----------------------------
# Read by monitor/devpath_monitor.py on every round, so a change here needs no
# reinstall. Installed with: sudo ./scripts/install-monitor.sh
#
# Where alerts go: an ntfy topic. No account -- install the ntfy app, subscribe
# to the same topic, and that is the whole setup. Anyone who knows a topic on
# ntfy.sh can read it, so make the name unguessable:
#   echo "https://ntfy.sh/devpath-$(openssl rand -hex 12)"
# Then prove it reaches the phone: python3 monitor/devpath_monitor.py test-alert
# Empty: rounds still run and write to the journal, nothing is sent.
MONITOR_NTFY_URL=
# Optional: a healthchecks.io-style ping URL. Pinged every good round, and
# /fail on a bad one; it alerts by itself when pings stop -- a dead monitor or
# a dead host, which nothing on this host can report.
MONITOR_HEARTBEAT_URL=
# Under these, it is a problem. certbot renews at 30 days left, so a served
# certificate under 14 means renewal or the nginx reload loop stopped.
MONITOR_CERT_MIN_DAYS=14
MONITOR_DISK_MIN_FREE_PERCENT=10

# --- Gemini (RAG ingest, chatbot) ---------------------------------------
# Empty means the ingest job logs a warning and writes nothing, and the rest
# of the site runs normally. Key from https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# gemini-embedding-001, not gemini-embedding-2: the newer model ignores
# taskType, and retrieval quality depends on it. Changing this re-embeds every
# chunk on the next ingest, because chunks remember the model that made them.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# The model that writes the assistant's answers, chosen on measurements in
# docs/report/assets/phase-4/chat-api.txt: 1.3 s to the first word, and the
# newer flash models answered 503/429 on the free tier. A 2.5-family model
# needs THINKING_LEVEL empty -- those take a budget and reject a level.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_THINKING_LEVEL=minimal

# --- Sizing -------------------------------------------------------------
# Two API workers and one transcode at a time suit a 2 vCPU / 4 GB VPS.
# ffmpeg takes whatever CPU it is given, so a second worker starves the API
# rather than finishing sooner.
UVICORN_WORKERS=2
CELERY_CONCURRENCY=1
# How many submissions are graded at once. Each one holds a sandbox container
# with half a core and 256 MB, so two is the ceiling on a 2 vCPU box -- the
# number to change when the VPS changes.
GRADING_CONCURRENCY=2
# How often one student may ask for grading: a cooldown per exercise and a
# quota per hour. Both protect the queue rather than discipline anyone.
SUBMISSION_COOLDOWN_SECONDS=10
SUBMISSION_HOURLY_LIMIT=40

# The host's docker group id, for docker-proxy -- the one container holding the
# socket (the grading worker goes through it). It runs as uid 10001 and cannot
# open a root-owned socket without being in that group. Find it with
#     getent group docker | cut -d: -f3
DOCKER_GID=999
